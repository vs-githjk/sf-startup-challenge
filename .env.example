# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM used by Cognee (cognify / search) and by our Python agents
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Anthropic (Claude-based agents, if used from Python)
ANTHROPIC_API_KEY=

# Cognee graph in Neo4j (docker compose up -d neo4j). Vectors stay in local LanceDB.
# Embeddings default to OpenAI and reuse LLM_API_KEY.
# Pick one long password; both lines must match.
NEO4J_PASSWORD=
GRAPH_DATABASE_PASSWORD=
GRAPH_DATABASE_PROVIDER=neo4j
GRAPH_DATABASE_URL=bolt://localhost:7687
GRAPH_DATABASE_USERNAME=neo4j
# Cognee 1.6 defaults to one Neo4j database per dataset; Neo4j Community has only one.
ENABLE_BACKEND_ACCESS_CONTROL=false

# Flexprice (bonus) — https://docs.flexprice.io
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://us.api.flexprice.io/v1

# Snyk — use a Personal Access Token, not the `snyk auth` OAuth session
SNYK_TOKEN=
