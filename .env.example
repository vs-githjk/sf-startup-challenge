# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM used by Cognee (cognify / search) and by our Python agents
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Anthropic (Claude-based agents, if used from Python)
ANTHROPIC_API_KEY=

# Cognee storage — defaults are local (SQLite + LanceDB + Kuzu), no server needed.
# Optional Neo4j graph backend (extra credit):
# GRAPH_DATABASE_PROVIDER=neo4j
# GRAPH_DATABASE_URL=bolt://localhost:7687
# GRAPH_DATABASE_USERNAME=neo4j
# GRAPH_DATABASE_PASSWORD=

# Flexprice (bonus) — https://docs.flexprice.io
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://api.cloud.flexprice.io/v1

# Snyk — use a Personal Access Token, not the `snyk auth` OAuth session
SNYK_TOKEN=
