# Copy to .env and fill in. .env is gitignored — never commit real keys.

# LLM used by Cognee (cognify / search) and by our Python agents
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
LLM_API_KEY=

# Anthropic (Claude-based agents, if used from Python)
ANTHROPIC_API_KEY=

# Cognee runs as a container (docker compose up -d neo4j cognee) with its graph in Neo4j;
# vectors stay in LanceDB inside the cognee volume. docker-compose.yml wires the graph settings
# and turns access control off (Neo4j Community has one database, Cognee 1.6 wants one per dataset).
# Embeddings default to OpenAI and reuse LLM_API_KEY (override with EMBEDDING_PROVIDER, EMBEDDING_MODEL,
# EMBEDDING_DIMENSIONS, EMBEDDING_API_KEY).
# Pick one long password.
NEO4J_PASSWORD=
# Where keep-api finds the Cognee container (default http://127.0.0.1:8000).
# COGNEE_URL=http://127.0.0.1:8000

# Flexprice (bonus) — https://docs.flexprice.io
FLEXPRICE_API_KEY=
FLEXPRICE_BASE_URL=https://us.api.flexprice.io/v1

# Snyk — use a Personal Access Token, not the `snyk auth` OAuth session
SNYK_TOKEN=
